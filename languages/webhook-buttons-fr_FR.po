msgstr "Rechercher des options…"

#: react-settings-ui/dist/assets/main.js:121
msgid "No options found"
msgstr "Aucune option trouvée"

#: react-settings-ui/dist/assets/main.js:121
msgid "All options selected"
msgstr "Toutes les options sont sélectionnées"

#: react-settings-ui/dist/assets/main.js:121
msgid "The server sent unexpected data. Please refresh and try again."
msgstr "Le serveur a renvoyé des données inattendues. Veuillez actualiser la page et réessayer."

#: react-settings-ui/dist/assets/main.js:121
msgid "Loading advanced settings…"
msgstr "Chargement des réglages avancés…"

#: react-settings-ui/dist/assets/main.js:121
msgid "Advanced settings"
msgstr "Réglages avancés"

#: react-settings-ui/dist/assets/main.js:121
msgid "Extra options for the data each button sends"
msgstr "Options supplémentaires pour les données envoyées par chaque bouton"

#: react-settings-ui/dist/assets/main.js:121
msgid "Undo changes"
msgstr "Annuler les modifications"

#: react-settings-ui/dist/assets/main.js:121
msgid "Save changes"
msgstr "Enregistrer les modifications"

#: react-settings-ui/dist/assets/main.js:121
msgid "General"
msgstr "Général"

#: react-settings-ui/dist/assets/main.js:121
msgid "Exclude product attributes"
msgstr "Exclure des attributs de produit"

#: react-settings-ui/dist/assets/main.js:121
msgid "Select attributes to leave out…"
msgstr "Sélectionner les attributs à exclure…"

#: react-settings-ui/dist/assets/main.js:121
msgid "These product attributes are not sent."
msgstr "Ces attributs de produit ne sont pas envoyés."

#: react-settings-ui/dist/assets/main.js:121
msgid "All settings saved"
msgstr "Tous les réglages sont enregistrés"

#: react-settings-ui/dist/assets/main.js:121
msgid "Pro options"
msgstr "Options Pro"

#: react-settings-ui/dist/assets/main.js:121
msgid "(needs an active license)"
msgstr "(nécessite une licence active)"

#: react-settings-ui/dist/assets/main.js:121
msgid "Visible to"
msgstr "Visible par"

#: react-settings-ui/dist/assets/main.js:121
msgid "All users who can edit orders"
msgstr "Tous les utilisateurs pouvant modifier les commandes"

#: react-settings-ui/dist/assets/main.js:121
msgid "Let the user add a note"
msgstr "Autoriser l’utilisateur à ajouter une note"

#: react-settings-ui/dist/assets/main.js:121
msgid "(needs “Ask to confirm first”)"
msgstr "(nécessite « Demander une confirmation d’abord »)"

#: react-settings-ui/dist/assets/main.js:121
msgid "Send flat data (one level, for tools that cannot read nested fields)"
msgstr "Envoyer des données à plat (un seul niveau, pour les outils qui ne lisent pas les champs imbriqués)"

#: react-settings-ui/dist/assets/main.js:121
msgid "Auth header (optional)"
msgstr "En-tête d’authentification (facultatif)"

#: react-settings-ui/dist/assets/main.js:121
msgid "Header name, for example X-Api-Key"
msgstr "Nom de l’en-tête, par exemple X-Api-Key"

#: react-settings-ui/dist/assets/main.js:121
msgid "Header value (secret)"
msgstr "Valeur de l’en-tête (secrète)"

#: react-settings-ui/dist/assets/main.js:121
msgid "Sent with every request from this button. Stored in your WordPress database."
msgstr "Envoyé avec chaque requête de ce bouton. Stocké dans votre base de données WordPress."

#: react-settings-ui/dist/assets/main.js:121
msgid "(Pro, needs an active license)"
msgstr "(Pro, nécessite une licence active)"

#: react-settings-ui/dist/assets/main.js:121
msgid "Order meta keys"
msgstr "Clés méta de commande"

#: react-settings-ui/dist/assets/main.js:121
msgid "Send extra order fields saved by other plugins (Advanced Custom Fields, Checkout Field Editor, and more). Pick the keys below. They are sent with every button under custom_fields, named by key."
msgstr "Envoyez des champs de commande supplémentaires enregistrés par d’autres extensions (Advanced Custom Fields, Checkout Field Editor, etc.). Choisissez les clés ci-dessous. Elles sont envoyées avec chaque bouton sous custom_fields, nommées par clé."

#: react-settings-ui/dist/assets/main.js:121
msgid "Pick meta keys to send…"
msgstr "Choisir les clés méta à envoyer…"

#: react-settings-ui/dist/assets/main.js:121
msgid "No order meta found yet. Create an order first."
msgstr "Aucune méta de commande trouvée pour le moment. Créez d’abord une commande."

#: react-settings-ui/dist/assets/main.js:121
msgid "Keys come from your last 200 orders. Keys that start with “_” are private plugin data."
msgstr "Les clés proviennent de vos 200 dernières commandes. Les clés commençant par « _ » sont des données privées d’extensions."

#: react-settings-ui/dist/assets/main.js:121
msgid "Custom order fields"
msgstr "Champs de commande personnalisés"

#: react-settings-ui/dist/assets/main.js:121
msgid "No Admin Custom Order Fields plugin found. When it is active, every custom order field is sent under custom_fields automatically."
msgstr "Extension Admin Custom Order Fields introuvable. Lorsqu’elle est active, chaque champ de commande personnalisé est envoyé automatiquement sous custom_fields."

#: react-settings-ui/dist/assets/main.js:121
msgid "These fields are sent with every order under custom_fields. The key never changes, even if you rename the field."
msgstr "Ces champs sont envoyés avec chaque commande sous custom_fields. La clé ne change jamais, même si vous renommez le champ."

#: react-settings-ui/dist/assets/main.js:121
msgid "Could not build the sample."
msgstr "Impossible de générer l’exemple."

#: react-settings-ui/dist/assets/main.js:121
msgid "Could not send the sample."
msgstr "Impossible d’envoyer l’exemple."

#: react-settings-ui/dist/assets/main.js:121
msgid "Close"
msgstr "Fermer"

#: react-settings-ui/dist/assets/main.js:121
msgid "What this button sends"
msgstr "Ce que ce bouton envoie"

#: react-settings-ui/dist/assets/main.js:121
msgid "Send a sample to your webhook so Zapier, Make or n8n can see every field. Tools only let you map fields they have seen, so pick at least as many items as your biggest real order."
msgstr "Envoyez un exemple à votre webhook pour que Zapier, Make ou n8n voient tous les champs. Ces outils ne permettent de mapper que les champs déjà vus : choisissez donc au moins autant d’articles que votre plus grosse commande réelle."

#: react-settings-ui/dist/assets/main.js:121
msgid "Items in sample"
msgstr "Articles dans l’exemple"

#: react-settings-ui/dist/assets/main.js:121
msgid "Copied!"
msgstr "Copié !"

#: react-settings-ui/dist/assets/main.js:121
msgid "Copy JSON"
msgstr "Copier le JSON"

#: react-settings-ui/dist/assets/main.js:121
msgid "Building sample…"
msgstr "Génération de l’exemple…"

#: react-settings-ui/dist/assets/main.js:121
msgid "Sample values only. Sending a sample does not count as a free send."
msgstr "Valeurs d’exemple uniquement. L’envoi d’un exemple ne compte pas comme un envoi gratuit."

#: react-settings-ui/dist/assets/main.js:121
msgid "Post this sample to the webhook URL"
msgstr "Envoyer cet exemple à l’URL du webhook"

#: react-settings-ui/dist/assets/main.js:121
msgid "Add a webhook URL first"
msgstr "Ajoutez d’abord une URL de webhook"

#: react-settings-ui/dist/assets/main.js:121
msgid "Sending…"
msgstr "Envoi…"

#: react-settings-ui/dist/assets/main.js:121
msgid "Send sample to webhook"
msgstr "Envoyer l’exemple au webhook"

#: react-settings-ui/dist/assets/main.js:111
msgid "This is the free version. Pro adds custom fields, flat data, staff notes, user access control, sample sends and auth headers."
msgstr "Ceci est la version gratuite. Pro ajoute les champs personnalisés, les données à plat, les notes du personnel, le contrôle d’accès par utilisateur, les envois d’exemple et les en-têtes d’authentification."
