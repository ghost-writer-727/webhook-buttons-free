#. Plugin Name of the plugin
#: webhook-buttons.php
msgid "Webhook Buttons for WooCommerce"
msgstr "Webhook Buttons for WooCommerce"

#. Plugin URI of the plugin
#: webhook-buttons.php
msgid "https://noblestrategies.dev/webhook-buttons"
msgstr "https://noblestrategies.dev/webhook-buttons"

#. Description of the plugin
#: webhook-buttons.php
msgid "Adds buttons to the WooCommerce order screen. Each button sends the order data to a webhook URL you choose."
msgstr "Ajoute des boutons à l’écran de commande WooCommerce. Chaque bouton envoie les données de la commande à l’URL de webhook de votre choix."

#. Author of the plugin
#: webhook-buttons.php
msgid "Noble Strategies"
msgstr "Noble Strategies"

#. Author URI of the plugin
