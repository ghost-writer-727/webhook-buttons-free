msgstr "Ajouter votre premier bouton"

#: react-settings-ui/dist/assets/main.js:121
msgid "Tips"
msgstr "Astuces"

#: react-settings-ui/dist/assets/main.js:121
msgid "Drag the grip handle to reorder boxes and buttons."
msgstr "Faites glisser la poignée pour réordonner les blocs et les boutons."

#: react-settings-ui/dist/assets/main.js:121
msgid "Click the arrow to open or close a box or button."
msgstr "Cliquez sur la flèche pour ouvrir ou fermer un bloc ou un bouton."

#: react-settings-ui/dist/assets/main.js:121
msgid "A button shows on the order screen only when it is enabled and has a webhook URL."
msgstr "Un bouton n’apparaît sur l’écran de commande que s’il est activé et possède une URL de webhook."

#: react-settings-ui/dist/assets/main.js:121
msgid "Click “Save all” to keep your changes."
msgstr "Cliquez sur « Tout enregistrer » pour conserver vos modifications."

#: react-settings-ui/dist/assets/main.js:121
