msgstr "Blocs de boutons"

#: react-settings-ui/dist/assets/main.js:121
msgid "Each box shows on the order screen with its buttons."
msgstr "Chaque bloc apparaît sur l’écran de commande avec ses boutons."

#: react-settings-ui/dist/assets/main.js:121
msgid "Add box"
msgstr "Ajouter un bloc"

#: react-settings-ui/dist/assets/main.js:121
msgid "Buttons appear in a box on the order screen."
msgstr "Les boutons apparaissent dans un bloc sur l’écran de commande."

