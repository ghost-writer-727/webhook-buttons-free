msgid "Select attributes to leave out…"
msgstr "Attribute auswählen, die weggelassen werden …"

#: react-settings-ui/dist/assets/main.js:121
msgid "These product attributes are not sent."
msgstr "Diese Produktattribute werden nicht gesendet."

#: react-settings-ui/dist/assets/main.js:121
msgid "All settings saved"
msgstr "Alle Einstellungen gespeichert"

#: react-settings-ui/dist/assets/main.js:121
msgid "Pro options"
msgstr "Pro-Optionen"

#: react-settings-ui/dist/assets/main.js:121
msgid "(needs an active license)"
msgstr "(benötigt eine aktive Lizenz)"

#: react-settings-ui/dist/assets/main.js:121
