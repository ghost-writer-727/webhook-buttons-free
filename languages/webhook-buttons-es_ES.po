msgstr "Permitir que el usuario añada una nota"

#: react-settings-ui/dist/assets/main.js:121
msgid "(needs “Ask to confirm first”)"
msgstr "(requiere «Pedir confirmación antes»)"

#: react-settings-ui/dist/assets/main.js:121
msgid "Send flat data (one level, for tools that cannot read nested fields)"
msgstr "Enviar datos planos (un solo nivel, para herramientas que no leen campos anidados)"

#: react-settings-ui/dist/assets/main.js:121
msgid "Auth header (optional)"
msgstr "Cabecera de autenticación (opcional)"

#: react-settings-ui/dist/assets/main.js:121
msgid "Header name, for example X-Api-Key"
msgstr "Nombre de la cabecera, por ejemplo X-Api-Key"

#: react-settings-ui/dist/assets/main.js:121
msgid "Header value (secret)"
msgstr "Valor de la cabecera (secreto)"

#: react-settings-ui/dist/assets/main.js:121
msgid "Sent with every request from this button. Stored in your WordPress database."
msgstr "Se envía con cada petición de este botón. Se guarda en tu base de datos de WordPress."

#: react-settings-ui/dist/assets/main.js:121
msgid "(Pro, needs an active license)"
msgstr "(Pro, requiere una licencia activa)"

#: react-settings-ui/dist/assets/main.js:121
msgid "Order meta keys"
msgstr "Claves meta del pedido"

#: react-settings-ui/dist/assets/main.js:121
msgid "Send extra order fields saved by other plugins (Advanced Custom Fields, Checkout Field Editor, and more). Pick the keys below. They are sent with every button under custom_fields, named by key."
msgstr "Envía campos adicionales del pedido guardados por otros plugins (Advanced Custom Fields, Checkout Field Editor y más). Elige las claves abajo. Se envían con cada botón bajo custom_fields, con el nombre de la clave."

#: react-settings-ui/dist/assets/main.js:121
msgid "Pick meta keys to send…"
msgstr "Elige las claves meta que quieres enviar…"

#: react-settings-ui/dist/assets/main.js:121
msgid "No order meta found yet. Create an order first."
msgstr "Todavía no se han encontrado metadatos de pedidos. Crea un pedido primero."

#: react-settings-ui/dist/assets/main.js:121
msgid "Keys come from your last 200 orders. Keys that start with “_” are private plugin data."
msgstr "Las claves provienen de tus últimos 200 pedidos. Las claves que empiezan por «_» son datos privados de plugins."

#: react-settings-ui/dist/assets/main.js:121
msgid "Custom order fields"
msgstr "Campos personalizados del pedido"

#: react-settings-ui/dist/assets/main.js:121
msgid "No Admin Custom Order Fields plugin found. When it is active, every custom order field is sent under custom_fields automatically."
msgstr "No se ha encontrado el plugin Admin Custom Order Fields. Cuando está activo, cada campo personalizado del pedido se envía automáticamente bajo custom_fields."

#: react-settings-ui/dist/assets/main.js:121
msgid "These fields are sent with every order under custom_fields. The key never changes, even if you rename the field."
msgstr "Estos campos se envían con cada pedido bajo custom_fields. La clave nunca cambia, aunque renombres el campo."

#: react-settings-ui/dist/assets/main.js:121
msgid "Could not build the sample."
msgstr "No se ha podido generar la muestra."

#: react-settings-ui/dist/assets/main.js:121
msgid "Could not send the sample."
msgstr "No se ha podido enviar la muestra."

#: react-settings-ui/dist/assets/main.js:121
msgid "Close"
msgstr "Cerrar"

#: react-settings-ui/dist/assets/main.js:121
msgid "What this button sends"
msgstr "Qué envía este botón"

#: react-settings-ui/dist/assets/main.js:121
msgid "Send a sample to your webhook so Zapier, Make or n8n can see every field. Tools only let you map fields they have seen, so pick at least as many items as your biggest real order."
msgstr "Envía una muestra a tu webhook para que Zapier, Make o n8n vean todos los campos. Estas herramientas solo permiten mapear campos que ya han visto, así que elige al menos tantos artículos como tu pedido real más grande."

#: react-settings-ui/dist/assets/main.js:121
msgid "Items in sample"
msgstr "Artículos en la muestra"

#: react-settings-ui/dist/assets/main.js:121
msgid "Copied!"
msgstr "¡Copiado!"

#: react-settings-ui/dist/assets/main.js:121
msgid "Copy JSON"
msgstr "Copiar JSON"

#: react-settings-ui/dist/assets/main.js:121
msgid "Building sample…"
msgstr "Generando la muestra…"

#: react-settings-ui/dist/assets/main.js:121
msgid "Sample values only. Sending a sample does not count as a free send."
msgstr "Solo valores de muestra. Enviar una muestra no cuenta como envío gratuito."

#: react-settings-ui/dist/assets/main.js:121
msgid "Post this sample to the webhook URL"
msgstr "Enviar esta muestra a la URL del webhook"

#: react-settings-ui/dist/assets/main.js:121
msgid "Add a webhook URL first"
msgstr "Añade primero una URL de webhook"

#: react-settings-ui/dist/assets/main.js:121
msgid "Sending…"
msgstr "Enviando…"

#: react-settings-ui/dist/assets/main.js:121
msgid "Send sample to webhook"
msgstr "Enviar muestra al webhook"

#: react-settings-ui/dist/assets/main.js:111
msgid "This is the free version. Pro adds custom fields, flat data, staff notes, user access control, sample sends and auth headers."
msgstr "Esta es la versión gratuita. Pro añade campos personalizados, datos planos, notas del personal, control de acceso por usuario, envíos de muestra y cabeceras de autenticación."
