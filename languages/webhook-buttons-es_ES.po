#. Plugin Name of the plugin
#: webhook-buttons.php
msgid "Webhook Buttons for WooCommerce"
msgstr "Webhook Buttons for WooCommerce"

#. Plugin URI of the plugin
#: webhook-buttons.php
msgid "https://noblestrategies.dev/webhook-buttons"
msgstr "https://noblestrategies.dev/webhook-buttons"

#. Description of the plugin
#: webhook-buttons.php
msgid "Adds buttons to the WooCommerce order screen. Each button sends the order data to a webhook URL you choose."
msgstr "Añade botones a la pantalla de pedidos de WooCommerce. Cada botón envía los datos del pedido a la URL de webhook que elijas."

#. Author of the plugin
#: webhook-buttons.php
msgid "Noble Strategies"
msgstr "Noble Strategies"

