msgstr "Selecciona los atributos que quieres omitir…"

#: react-settings-ui/dist/assets/main.js:121
msgid "These product attributes are not sent."
msgstr "Estos atributos de producto no se envían."

#: react-settings-ui/dist/assets/main.js:121
msgid "All settings saved"
msgstr "Todos los ajustes guardados"

#: react-settings-ui/dist/assets/main.js:121
msgid "Pro options"
msgstr "Opciones Pro"

#: react-settings-ui/dist/assets/main.js:121
msgid "(needs an active license)"
msgstr "(requiere una licencia activa)"

#: react-settings-ui/dist/assets/main.js:121
