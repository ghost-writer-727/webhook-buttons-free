msgstr "Arrastra el asa para reordenar cajas y botones."

#: react-settings-ui/dist/assets/main.js:121
msgid "Click the arrow to open or close a box or button."
msgstr "Haz clic en la flecha para abrir o cerrar una caja o un botón."

#: react-settings-ui/dist/assets/main.js:121
msgid "A button shows on the order screen only when it is enabled and has a webhook URL."
msgstr "Un botón solo se muestra en la pantalla del pedido si está activado y tiene una URL de webhook."

#: react-settings-ui/dist/assets/main.js:121
msgid "Click “Save all” to keep your changes."
msgstr "Haz clic en «Guardar todo» para conservar tus cambios."

